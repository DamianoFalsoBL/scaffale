# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API Keys). Required. Publishable key: sb_publishable_…
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): bypasses RLS, server only. Required from phase 3 (catalog writes).
SUPABASE_SECRET_KEY=

# TMDB API Read Access Token (v4). Required from phase 2.
TMDB_READ_ACCESS_TOKEN=
# Google Books API key. Required from phase 2.
GOOGLE_BOOKS_API_KEY=

# Shared secret for Vercel Cron (Authorization: Bearer <CRON_SECRET>), min 16 chars. Required from phase 4.
CRON_SECRET=
# Optional, comma-separated. Only these emails can sign in (and create the first account). Empty = no allowlist.
ALLOWED_EMAILS=

# Public base URL of the app (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, local dev only: set to true if TMDB requests fail with ECONNRESET
# (networks with broken IPv6 to CloudFront). Makes server-side fetch prefer IPv4.
DNS_IPV4_FIRST=
